# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                              <mnt_point>   <type>      <mnt_flags and options>    <fs_mgr_flags>
system                                               /system       erofs        ro    avb=vbmeta,logical,first_stage_mount,display="System"
system                                               /system       ext4        	ro    avb=vbmeta,logical,first_stage_mount,display="System"
system                                               /system       f2fs        	ro    avb=vbmeta,logical,first_stage_mount,display="System"
vendor                                               /vendor       erofs        ro    avb,logical,first_stage_mount
product                                              /product      erofs        ro    avb,logical,first_stage_mount
odm                                                  /odm          erofs        ro    avb,logical,first_stage_mount
system_ext                                           /system_ext       erofs        ro    avb=vbmeta,logical,first_stage_mount,display="System_ext"

system_dlkm                                               /system_dlkm       erofs        ro    avb=vbmeta,logical,first_stage_mount
odm_dlkm                                             /odm_dlkm          erofs        ro    avb,logical,first_stage_mount
vendor_dlkm                                          /vendor_dlkm       erofs        ro    avb,logical,first_stage_mount

/dev/block/platform/bootdevice/by-name/md_udc      /metadata     ext4        defaults                  wait,first_stage_mount
/dev/block/by-name/userdata      		   /data         f2fs        defaults                  wait,length=-16384
/dev/block/by-name/misc          		   /misc         emmc        defaults                  recoveryonly
